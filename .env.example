# Gemini API key (free tier). Leave blank to read from the environment at runtime.
GEMINI_API_KEY=
# Primary model (always-free friendly). gemini-flash-lite-latest is a stable alias
# that currently maps to a free-tier-eligible flash-lite model.
GEMINI_MODEL=gemini-flash-lite-latest
# Fallback models tried in order if the primary is unavailable (e.g. deprecated).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
